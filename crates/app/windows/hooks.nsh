; FilePilot's own steps in the NSIS installer generated by Tauri (see tauri.bundle.json).
;
; The daemon (filepilot.exe) runs in the background and keeps its file open: it is stopped
; before copying and started again afterwards if it was running. Stopping it abruptly is
; safe: the journal is write-ahead and the daemon reconciles unfinished work on start (the
; same as "Quit" from the tray icon). The window (filepilot-ui.exe) is handled by the Tauri
; installer, which asks before closing it so unsaved edits aren't lost silently.
;
; Before 1.0 the app was called "Organizator" (organizator.exe, %LOCALAPPDATA%\Organizator).
; Such an install is removed first, keeping the user's data (the app moves its data folder
; from %APPDATA%\Organizator to %APPDATA%\FilePilot on first start), and its autostart is
; carried over.

Var DaemonWasRunning
Var HadLegacyAutostart

!macro FpRunning EXE RESULT
  nsExec::ExecToStack 'tasklist /FI "IMAGENAME eq ${EXE}" /NH'
  Pop $0 ; exit code
  Pop $1 ; output
  StrCpy ${RESULT} 0
  ${StrLoc} $2 $1 "${EXE}" ">"
  ${If} $2 != ""
    StrCpy ${RESULT} 1
  ${EndIf}
!macroend

!macro FpStop EXE
  nsExec::Exec 'taskkill /F /IM ${EXE}'
  Pop $0
  ; Windows releases the file a moment after the process ends.
  Sleep 800
!macroend

!macro NSIS_HOOK_PREINSTALL
  ; The former "Organizator" install: carry over autostart, stop it and remove it.
  StrCpy $HadLegacyAutostart 0
  ReadRegStr $0 HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "Organizator"
  ${If} $0 != ""
    StrCpy $HadLegacyAutostart 1
  ${EndIf}
  !insertmacro FpRunning "organizator.exe" $DaemonWasRunning
  !insertmacro FpStop "organizator.exe"
  ${If} ${FileExists} "$LOCALAPPDATA\Organizator\uninstall.exe"
    DetailPrint "Removing the previous version (Organizator)..."
    ; _?= runs the uninstaller in place and waits for it; silent mode keeps the data.
    ExecWait '"$LOCALAPPDATA\Organizator\uninstall.exe" /S _?=$LOCALAPPDATA\Organizator'
    Delete "$LOCALAPPDATA\Organizator\uninstall.exe"
    RMDir "$LOCALAPPDATA\Organizator"
  ${EndIf}
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "Organizator"

  ; The current daemon.
  !insertmacro FpRunning "filepilot.exe" $0
  ${If} $0 = 1
    StrCpy $DaemonWasRunning 1
    DetailPrint "Stopping the FilePilot service..."
    !insertmacro FpStop "filepilot.exe"
  ${EndIf}
  ; Otherwise the installer may keep the old executable (it has no version resource).
  Delete "$INSTDIR\filepilot.exe"
!macroend

!macro NSIS_HOOK_POSTINSTALL
  ; Autostart pointing elsewhere (a portable copy, the former name) now points to the
  ; installed daemon. If it wasn't enabled it stays off (the setup guide enables it).
  ReadRegStr $0 HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${PRODUCTNAME}"
  ${If} $0 != ""
  ${OrIf} $HadLegacyAutostart = 1
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${PRODUCTNAME}" '"$INSTDIR\filepilot.exe"'
  ${EndIf}
  ${If} $DaemonWasRunning = 1
    DetailPrint "Starting the FilePilot service again..."
    nsis_tauri_utils::RunAsUser "$INSTDIR\filepilot.exe" ""
  ${EndIf}
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro FpStop "filepilot.exe"
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; "Also delete the data": rules, journal and catalog live in %APPDATA%\FilePilot (the
  ; Tauri uninstaller only deletes the folders named after the identifier).
  ${If} $DeleteAppDataCheckboxState = 1
  ${AndIf} $UpdateMode <> 1
    SetShellVarContext current
    RmDir /r "$APPDATA\${PRODUCTNAME}"
  ${EndIf}
!macroend
